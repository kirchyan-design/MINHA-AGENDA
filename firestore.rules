rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário lê e grava somente os próprios dados (users/{uid} e users/{uid}/dados/*).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /dados/{parte} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Menu Comentários (públicos): qualquer pessoa LÊ os comentários e ENVIA um novo.
    // Cada comentário guarda o campo "uid": o id ANÔNIMO e aleatório do aparelho de quem escreveu (sem nome, e-mail ou
    // telefone). Só esse mesmo uid pode EDITAR ou EXCLUIR o comentário. Comentários antigos (sem uid) só se apagam
    // pelo console do Firebase (Firestore Database › comentarios), que não passa por estas regras.
    // Pré-requisito: Firebase › Authentication › Método de login › Anônimo = ATIVADO.
    function comValido(d) {
      return d.keys().hasOnly(
            ['nota','gostou','melhorar','nome','anonimo','versao','plataforma','idioma','criadoEm','uid','editadoEm'])
        && d.nota is int && d.nota >= 0 && d.nota <= 4
        && d.gostou is string && d.gostou.size() <= 700
        && d.melhorar is string && d.melhorar.size() <= 700
        && d.nome is string && d.nome.size() <= 60
        && d.anonimo is bool
        && d.versao is string && d.versao.size() <= 20
        && d.plataforma is string && d.plataforma.size() <= 20
        && d.idioma is string && d.idioma.size() <= 5
        && d.criadoEm is timestamp
        && (d.nota > 0 || d.gostou.size() > 0 || d.melhorar.size() > 0);
    }

    match /comentarios/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 50;
      // com login anônimo: uid obrigatório e igual ao do usuário; sem login (ex.: Anônimo desativado): sem uid
      allow create: if comValido(request.resource.data)
        && ((request.auth != null && request.resource.data.uid == request.auth.uid)
            || (request.auth == null && !('uid' in request.resource.data)));
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.criadoEm == resource.data.criadoEm
        && comValido(request.resource.data);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Contato opcional de quem quer resposta: só o dono do projeto lê (pelo console).
    match /comentarios_contatos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['contato'])
        && request.resource.data.contato is string
        && request.resource.data.contato.size() > 0 && request.resource.data.contato.size() <= 100;
      allow read, update, delete: if false;
    }

    // Denúncias de comentários: qualquer pessoa envia; só o dono do projeto lê (pelo console).
    match /denuncias/{id} {
      allow create: if request.resource.data.keys().hasOnly(['comentario','criadoEm'])
        && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 40
        && request.resource.data.criadoEm is timestamp;
      allow read, update, delete: if false;
    }
  }
}
