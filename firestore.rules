rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário lê e grava somente os próprios dados (users/{uid} e users/{uid}/dados/*).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /dados/{parte} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
